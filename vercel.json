{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/c/:slug",
      "destination": "/api/c?slug=:slug"
    },
    {
      "source": "/convite",
      "destination": "/convite/editor"
    },
    {
      "source": "/a/:slug",
      "destination": "/album/enviar"
    },
    {
      "source": "/album",
      "destination": "/album/painel"
    }
  ],
  "headers": [
    {
      "source": "/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}